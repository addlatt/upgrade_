 {
  "name": "storage is a %include the verifier writes, never inline",
  "origin": "selftest",
  "parts": [
   {
    "base": "job.keep-windows.json",
    "ops": [],
    "label": "UPGV0",
    "manifest": null,
    "asserts": [
     [
      "line",
      "%include /tmp/upgrade_-storage.ks"
     ],
     [
      "no_line_prefix",
      "part "
     ],
     [
      "no_line_prefix",
      "clearpart "
     ],
     [
      "no_line_prefix",
      "ignoredisk "
     ],
     [
      "no_line_prefix",
      "autopart "
     ]
    ]
   }
  ]
 },
 {
  "name": "%pre runs verify.sh with the job and the stick label, erroring on failure",
  "origin": "selftest",
  "parts": [
   {
    "base": "job.keep-windows.json",
    "ops": [],
    "label": "UPGV0",
    "manifest": null,
    "asserts": [
     [
      "line",
      "%pre --log=/tmp/upgrade_-pre.log --erroronfail"
     ],
     [
      "line_suffix",
      "verify.sh /run/install/repo/upgrade_/job.json UPGV0"
     ]
    ]
   }
  ]
 },
 {
  "name": "keep-windows %post turns os-prober off and writes its own Windows entry, chainloading the kept name when it exists; clean-slate does neither",
  "origin": "selftest",
  "parts": [
   {
    "base": "job.keep-windows.json",
    "ops": [],
    "label": "UPGV0",
    "manifest": null,
    "asserts": [
     [
      "contains",
      "GRUB_DISABLE_OS_PROBER=true"
     ],
     [
      "contains",
      "menuentry 'Windows (kept)'"
     ],
     [
      "contains",
      "bootmgfw-kept.efi; else chainloader /EFI/Microsoft/Boot/bootmgfw.efi"
     ]
    ]
   },
   {
    "base": "job.clean-slate.json",
    "ops": [],
    "label": "UPGV0",
    "manifest": null,
    "asserts": [
     [
      "not_contains",
      "OS_PROBER"
     ]
    ]
   }
  ]
 },

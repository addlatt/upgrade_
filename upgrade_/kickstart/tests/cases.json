 {
  "name": "lang, keymap, timezone come from intent.locale",
  "origin": "selftest",
  "parts": [
   {
    "base": "job.keep-windows.json",
    "ops": [],
    "label": "UPGV0",
    "manifest": null,
    "asserts": [
     [
      "line",
      "lang en_US.UTF-8"
     ],
     [
      "line",
      "keyboard --xlayouts='us'"
     ],
     [
      "line",
      "timezone America/New_York"
     ]
    ]
   }
  ]
 },
 {
  "name": "keep-windows leaves the hardware clock in local time, as the kept Windows expects (no --utc; RISKS R36, decided 2026-10-10); clean-slate, or a Windows that kept UTC, says --utc",
  "origin": "selftest",
  "parts": [
   {
    "base": "job.keep-windows.json",
    "ops": [],
    "label": "UPGV0",
    "manifest": null,
    "asserts": [
     [
      "line",
      "timezone America/New_York"
     ]
    ]
   },
   {
    "base": "job.clean-slate.json",
    "ops": [],
    "label": "UPGV0",
    "manifest": null,
    "asserts": [
     [
      "line",
      "timezone Europe/London --utc"
     ]
    ]
   },
   {
    "base": "job.keep-windows.json",
    "ops": [
     [
      [
       "harvest",
       "clock",
       "rtc_is_local"
      ],
      false
     ]
    ],
    "label": "UPGV0",
    "manifest": null,
    "asserts": [
     [
      "line",
      "timezone America/New_York --utc"
     ]
    ]
   }
  ]
 },
 {
  "name": "the password hash passes through untouched and root is locked",
  "origin": "selftest",
  "parts": [
   {
    "base": "job.keep-windows.json",
    "ops": [],
    "label": "UPGV0",
    "manifest": null,
    "asserts": [
     [
      "contains",
      "--iscrypted --password={password_hash} --groups=wheel"
     ],
     [
      "line",
      "rootpw --lock"
     ]
    ]
   }
  ]
 },
 {
  "name": "the desktop selects the squashfs",

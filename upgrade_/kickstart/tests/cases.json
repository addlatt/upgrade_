 {
  "name": "the nochroot %post runs outcome.sh after the chroot %post",
  "origin": "selftest",
  "parts": [
   {
    "base": "job.keep-windows.json",
    "ops": [],
    "label": "UPGV0",
    "manifest": null,
    "asserts": [
     [
      "line",
      "%post --nochroot --log=/tmp/upgrade_-outcome-post.log"
     ],
     [
      "before",
      "%post --log=/root/upgrade_-post.log",
      "%post --nochroot"
     ],
     [
      "contains",
      "outcome.sh /run/install/repo/upgrade_/job.json"
     ]
    ]
   }
  ]
 },
 {
  "name": "a manifest adds --checksum for the chosen desktop image",

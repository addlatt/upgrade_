# upgrade_ settle-in: the first startup (architecture.md, "Module 3: settle-in").
# Installed by the distribution's installer adapter (Fedora: outcome.sh) with
# the settle-in binary. Runs once, early: after the disks are mounted, before
# the network and before any time service, so the clock is right before
# anything relies on it and the Wi-Fi connections exist before NetworkManager
# starts and reads them.
[Unit]
Description=upgrade_ settle-in: first startup (clock, Wi-Fi)
DefaultDependencies=no
After=local-fs.target systemd-remount-fs.service
Before=sysinit.target time-set.target time-sync.target chronyd.service systemd-timesyncd.service network-pre.target NetworkManager.service shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target
ConditionPathExists=/var/lib/upgrade_/job.json
ConditionPathExists=!/var/lib/upgrade_/settle-in/first-start.done

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/upgrade_/settle-in first-start
RemainAfterExit=yes
StandardOutput=journal+console

[Install]
WantedBy=sysinit.target

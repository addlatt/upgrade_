<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- upgrade_ settle-in: plain words for the password prompt the old-boot-entry
     button raises (approved 2026-09-27, the owner). Without this file the
     desktop shows the program's path. Installed in /usr/share/polkit-1/actions/
     by the installer adapter. Two actions, told apart by the first argument:
     `settle-in remove-old-boot-entry` and `settle-in go-back` (its root
     steps: `walkaway prepare` and `walkaway undo`, RISKS R33; the guided
     stick's `write` left with roadmap item 20, the action id kept; the
     go-back words are a DRAFT). A third, `settle-in reclaim` (its check,
     arm and disarm, RISKS R41; words a DRAFT): auth_admin_keep, so the
     check and the arm a minute later ask for the password once. A fourth,
     `settle-in pull` (its check and run, decided 2026-11-07; words a DRAFT):
     auth_admin_keep, so the check and the copy ask once. -->
<policyconfig>
  <vendor>upgrade_</vendor>
  <action id="org.upgrade.settle-in.remove-old-boot-entry">
    <description>Remove the old Windows startup entry</description>
    <message>Removing the old Windows startup entry changes this computer's startup settings. Type your password to allow it.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/upgrade_/settle-in</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">remove-old-boot-entry</annotate>
  </action>
  <action id="org.upgrade.settle-in.go-back-write">
    <description>Prepare the way back to Windows</description>
    <message>Preparing the way back to Windows deletes everything on the USB stick you chose and sets this computer to start from it once. Nothing on this computer is deleted until you click Restart now. Type your password to allow it.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/upgrade_/settle-in</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">go-back</annotate>
  </action>
  <action id="org.upgrade.settle-in.rollback">
    <description>Make Windows start first again</description>
    <message>Making Windows start first again changes this computer's startup files and order. Nothing is deleted. Type your password to allow it.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/upgrade_/settle-in</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">rollback</annotate>
  </action>
  <action id="org.upgrade.settle-in.reclaim">
    <description>Free up Windows' space</description>
    <message>Checking whether Windows' space can be given to Linux reads this computer's disk and Windows' drive. Nothing is deleted until you click Restart now. Type your password to allow it.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/upgrade_/settle-in</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">reclaim</annotate>
  </action>
  <action id="org.upgrade.settle-in.pull">
    <description>Bring your files over from Windows</description>
    <message>Bringing your files over reads Windows' drive (unlocking it with its recovery key if it is locked) and copies your files into your folders here. Nothing on Windows changes. Type your password to allow it.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/upgrade_/settle-in</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">pull</annotate>
  </action>
</policyconfig>
